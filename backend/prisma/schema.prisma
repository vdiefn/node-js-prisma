generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(50)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  role       String   @default("USER")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  coach Coach?
  creditPurchase CreditPurchase[]
}

model Skill {
  id         String   @id @default(uuid())
  name       String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
  coachSkill CoachSkill[]
  course Course[]
}

model CreditPackage {
  id String @id @default(uuid())
  name String @unique @db.VarChar(50)
  creditAmount Int @map("credit_amount")
  price Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credit_packages")
  creditPurchase CreditPurchase[]
}

model Coach {
  id String @id @default(uuid())
  userId String @unique @map("user_id")
  experienceYears Int @map("experience_years")
  description String @db.VarChar(255)
  profileImageUrl String? @db.VarChar(2048) @map("profile_image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coaches")
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  coachSkill CoachSkill[]
  course Course[]
}

model CoachSkill {
  id String @id @default(uuid())
  coachId String @map("coach_id")
  skillId String @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_skills")
  @@unique([coachId, skillId])

  coach Coach @relation(fields:[coachId], references:[id], onDelete: Cascade)
  skill Skill @relation(fields:[skillId], references:[id], onDelete:Cascade)
}

model Course {
  id String @id @default(uuid())
  coachId String @map("coach_id")
  skillId String @map("skill_id")
  name String @db.VarChar(30)
  description String @db.VarChar(255)
  endAt DateTime @map("end_at")
  startAt DateTime @map("start_at")
  maxParticipants Int @default(15) @map("max_participants")
  meetingUrl String @db.VarChar(255)
  participants Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("courses")

  coach Coach @relation(fields:[coachId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields:[skillId], references:[id], onDelete: Restrict)
}

model CreditPurchase {
  id String @id @default(uuid())
  userId String @map("user_id")
  creditPackageId String @map("credit_package_id")
  purchasedCredit Int @map("purchased_credit")
  pricePaid Int @map("price_paid")
  purchasedAt DateTime @default(now()) @map("purchased_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credit_purchases")

  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  creditPackage CreditPackage @relation(fields:[creditPackageId], references:[id], onDelete:Restrict)
}